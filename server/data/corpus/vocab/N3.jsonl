{"headword":"十","reading":"じゅう","gloss_ja":"数の十。","gloss_zh":"十。","source":"curated","license":"CC-BY-SA-4.0"}
{"headword":"四","reading":"し","gloss_ja":"数の四。","gloss_zh":"四。","source":"curated","license":"CC-BY-SA-4.0"}
{"headword":"多分","reading":"たぶん","gloss_ja":"はっきりしないが、そうだと思うこと。","gloss_zh":"大概、也許。","source":"curated","license":"CC-BY-SA-4.0"}
{"headword":"夜","reading":"よる","gloss_ja":"日が沈んで暗い時間。","gloss_zh":"夜晚。","source":"curated","license":"CC-BY-SA-4.0"}
